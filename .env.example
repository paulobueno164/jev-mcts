# ESTE ARQUIVO E O MODELO E VAI PARA O REPOSITORIO. Nao cole a chave aqui:
# copie para .env (que esta no .gitignore) e preencha la.
#
# Uma das duas chaves habilita o avaliador real (--evaluator jev).
# Sem nenhuma delas o repositorio inteiro roda offline com o avaliador scripted.
TYPESAFE_AI_API_KEY=
AI_GATEWAY_API_KEY=

# Opcional: id do modelo de avaliacao. Default: typesafe-ai/jev
JEV_MODEL=typesafe-ai/jev
